# LLM provider: groq, ollama, or hf
LLM_PROVIDER=groq

# Groq settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama settings
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face settings
HF_API_KEY=
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1/chat/completions

# Embedding settings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Retrieval settings
TOP_K_RAG=5
RAG_CANDIDATE_MULTIPLIER=4
RAG_SYMBOL_BOOST=0.1
RAG_SECTOR_BOOST=0.05
NEWS_STALE_DAYS=30
MAX_SQL_RETRIES=3
REQUEST_TIMEOUT_SEC=60
LLM_TIMEOUT_SEC=120
ROUTER_TIMEOUT_SEC=15
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_DAY=200
SQL_TIMEOUT_MS=5000
SQL_MAX_ROWS=500
NEWS_COLLECTION=nepse_news

# Scraping settings
SCRAPE_DELAY_SEC=3
MAX_ARTICLES=5000

# News corpus health checks (news step fails below these unless NEWS_ALLOW_THIN_CORPUS=1)
NEWS_MIN_ARTICLES=50
NEWS_MAX_NEWEST_AGE_DAYS=14
NEWS_ALLOW_THIN_CORPUS=0
